{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Zurich",
  schedule: ["before 9am on monday"],
  dependencyDashboard: true,
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^kubernetes/.+values\\.ya?ml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/browcord/k8sguard\\.yaml$/"],
      matchStrings: ["value: \"(?<depName>ghcr\\.io/mmrmagno/browcord-room):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      matchManagers: ["flux"],
      groupName: "flux",
    },
    {
      description: "Small updates merge themselves once the validate check is green",
      matchUpdateTypes: ["digest", "pinDigest", "patch"],
      automerge: true,
    },
    {
      description: "The blog ships as soon as CI publishes it",
      matchPackageNames: ["ghcr.io/mmrmagno/marc-os-blog"],
      schedule: ["at any time"],
      automerge: true,
    },
    {
      description: "valart ships as soon as CI publishes it, like the blog",
      matchPackageNames: ["ghcr.io/mmrmagno/valart", "ghcr.io/mmrmagno/valart-submit"],
      groupName: "valart",
      schedule: ["at any time"],
      automerge: true,
    },
    {
      description: "The kb site ships as soon as CI publishes it",
      matchPackageNames: ["ghcr.io/mmrmagno/kb"],
      schedule: ["at any time"],
      automerge: true,
    },
    {
      description: "browcord restarts the gateway and kicks viewers, so it only ships at night",
      matchPackageNames: ["ghcr.io/mmrmagno/browcord-gateway", "ghcr.io/mmrmagno/browcord-room"],
      groupName: "browcord",
      schedule: ["* 3-5 * * *"],
      automerge: true,
    },
  ],
}
